APP_ENV=test
APP_ORIGIN=http://localhost:3000
AUTH_ENABLED=false
# Test runner requires both app and owner URLs pointing to the same *_test database.
# Portable setup creates these in .env.test.local; never copy production URLs.
DATABASE_URL=
DIRECT_DATABASE_URL=
BETTER_AUTH_SECRET=
AI_ENABLED=false
AI_API_KEY=
AI_MODEL=

# Explicit opt-in; demo records remain DRAFT and are never real offers.
DEMO_SEED_ENABLED=false
