# Copy to .env.local. Public R02 preview works without a database.
# Portable setup generates ignored local credentials; see doc/DATABASE.md.
APP_ENV=local
APP_ORIGIN=http://localhost:3000
AUTH_ENABLED=false
DATABASE_URL=
DIRECT_DATABASE_URL=
BETTER_AUTH_SECRET=
CONFIG_ENCRYPTION_KEY=
AI_ENABLED=false
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Explicit opt-in; demo records remain DRAFT and are never real offers.
DEMO_SEED_ENABLED=false

# Dedicated, disposable shadow database for migrate dev only; never the app database.
SHADOW_DATABASE_URL=
