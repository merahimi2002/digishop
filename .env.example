# Copy to .env.local. Public R02 preview works without a database.
# Portable setup generates ignored local credentials; see doc/DATABASE.md.
APP_ENV=local
APP_ORIGIN=http://localhost:3000
AUTH_ENABLED=false
AUTH_EMAIL_TRANSPORT=local
# Local mailbox only; preview/production require authenticated SMTP and HTTPS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Private owner identity; do not put the real value in public documentation.
OWNER_EMAIL=
DATABASE_URL=
DIRECT_DATABASE_URL=
BETTER_AUTH_SECRET=
CONFIG_ENCRYPTION_KEY=
AI_ENABLED=false
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Explicit opt-in; demo records remain DRAFT and are never real offers.
DEMO_SEED_ENABLED=false

# Dedicated, disposable shadow database for migrate dev only; never the app database.
SHADOW_DATABASE_URL=
